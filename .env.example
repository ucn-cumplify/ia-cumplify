# Shared secret with backend-cumplify (its AI_SERVICE_API_KEY). Required on every /api/v1 call
# as the X-API-Key header; empty rejects them with 503. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=replace_with_a_long_random_secret

OPENAI_API_KEY=sk-...
# Must accept prompt_cache_options (gpt-5.6 or later): every chat completions call uses the explicit prompt cache
OPENAI_MODEL=gpt-5.6-luna
# none | low | medium | high
OPENAI_REASONING_EFFORT=low

# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname

# DEV-ONLY (true/false): elapsed time + token usage on classify responses, and dev_metrics
# (elapsed_ms, first_delta_ms) in the done event of POST /api/v1/chat
INCLUDE_DEV_METRICS=true

# Max classifiable articles per Luna call (full body is still sent each call)
CLASSIFY_BATCH_SIZE=25
# POST /api/v1/embeddings defaults, used when the request does not set model or dimensions.
# The backend stores vectors in a vector(1024) column.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024
# Max texts per embeddings request (the backend sends batches of 50)
EMBEDDINGS_MAX_TEXTS=256
# POST /api/v1/company-profiles/classify: longest company description, after trimming.
# Keep it equal to the backend's AI_PROFILE_TEXT_MAX_CHARS; a longer text gets 422.
PROFILE_TEXT_MAX_CHARS=4000

# Per OpenAI HTTP call. Classification of a full legal body can take minutes.
OPENAI_TIMEOUT_SECONDS=180
# SDK retries on 408, 409, 429, 5xx, timeouts and connection errors. 0 disables retries.
OPENAI_MAX_RETRIES=2

# POST /api/v1/applicability-reasons. Kept under the backend's AI_APPLICABILITY_REASONS_TIMEOUT_SECONDS (30).
APPLICABILITY_REASONS_TIMEOUT_SECONDS=25
# 0: one attempt, so a retry does not blow the backend's 30 s budget.
APPLICABILITY_REASONS_MAX_RETRIES=0

# POST /api/v1/chat (streaming). It uses neither OPENAI_TIMEOUT_SECONDS nor OPENAI_MAX_RETRIES.
# Chat model. Empty: use OPENAI_MODEL
CHAT_MODEL=
# none | low | medium | high. Empty: use OPENAI_REASONING_EFFORT
CHAT_REASONING_EFFORT=
# Output cap per answer, reasoning included
CHAT_MAX_COMPLETION_TOKENS=4000
# Per attempt: longest wait for OpenAI's headers or for its next chunk (connecting has 5 s)
CHAT_TIMEOUT_SECONDS=60
# SDK retries, only before OpenAI answers 2xx. 0 leaves the retry to the backend.
CHAT_MAX_RETRIES=0
# Request limits: a request over one gets 422. Keep each equal to its mirror in the backend;
# the AI_CHAT_* names below are a proposal, the backend does not define them yet.
# Longest question, after trimming (backend: AI_CHAT_QUESTION_MAX_CHARS)
CHAT_QUESTION_MAX_CHARS=2000
# Most history messages, empty ones not counted (backend: AI_CHAT_HISTORY_MAX_MESSAGES)
CHAT_HISTORY_MAX_MESSAGES=6
# Most history characters, all messages added up (backend: AI_CHAT_HISTORY_MAX_CHARS)
CHAT_HISTORY_MAX_CHARS=8000
# Most passages per request (backend: AI_CHAT_MAX_PASSAGES)
CHAT_MAX_PASSAGES=12
# Longest text of one passage, after trimming (backend: AI_CHAT_PASSAGE_MAX_CHARS)
CHAT_PASSAGE_MAX_CHARS=6000
# Most characters of all passage texts added up (backend: AI_CHAT_PASSAGES_MAX_TOTAL_CHARS)
CHAT_PASSAGES_MAX_TOTAL_CHARS=48000
# DEV-ONLY (true/false): fixed answers without OpenAI or OPENAI_API_KEY (chat_version fake-v1@fake)
CHAT_FAKE_RESPONDER=false

# POST /api/v1/evidence-reviews. Timeout and retries are its own, under the backend's 90 s.
# Review model. Empty: use OPENAI_MODEL
EVIDENCE_REVIEW_MODEL=
# none | low | medium | high. Empty: use OPENAI_REASONING_EFFORT
EVIDENCE_REVIEW_REASONING_EFFORT=
# One structured call over the files of the review
EVIDENCE_REVIEW_TIMEOUT_SECONDS=80
# 0: one attempt, so a retry does not take the review past the backend's 90 s
EVIDENCE_REVIEW_MAX_RETRIES=0

# POST /api/v1/action-plans. Timeout and retries are its own, under the backend's 90 s (AI_ACTION_PLAN_TIMEOUT_SECONDS).
# Proposal model. Empty: use OPENAI_MODEL
ACTION_PLAN_MODEL=
# none | low | medium | high. Empty: use OPENAI_REASONING_EFFORT
ACTION_PLAN_REASONING_EFFORT=
# One structured call over the findings and their knowledge-base fragments
ACTION_PLAN_TIMEOUT_SECONDS=80
# 0: one attempt, so a retry does not take the proposal past the backend's 90 s
ACTION_PLAN_MAX_RETRIES=0
# Findings per request; one more gets 422. Proposed value, not agreed with the backend yet
ACTION_PLAN_MAX_FINDINGS=30
