# Shared secret with backend-cumplify (its AI_SERVICE_API_KEY). Required on every /api/v1 call
# as the X-API-Key header; empty rejects them with 503. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=replace_with_a_long_random_secret

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna
# none | low | medium | high
OPENAI_REASONING_EFFORT=low

# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname

# DEV-ONLY: elapsed time + token usage on classify responses (true/false)
INCLUDE_DEV_METRICS=true

# Max classifiable articles per Luna call (full body is still sent each call)
CLASSIFY_BATCH_SIZE=25
# POST /api/v1/embeddings defaults, used when the request does not set model or dimensions.
# The backend stores vectors in a vector(1024) column.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024
# Max texts per embeddings request (the backend sends batches of 50)
EMBEDDINGS_MAX_TEXTS=256
# POST /api/v1/company-profiles/classify: longest company description, after trimming.
# Keep it equal to the backend's AI_PROFILE_TEXT_MAX_CHARS; a longer text gets 422.
PROFILE_TEXT_MAX_CHARS=4000

# Per OpenAI HTTP call. Classification of a full legal body can take minutes.
OPENAI_TIMEOUT_SECONDS=180
# SDK retries on 408, 409, 429, 5xx, timeouts and connection errors. 0 disables retries.
OPENAI_MAX_RETRIES=2
